# Live site er domain (SEO, share preview, sitemap). Vercel e Environment Variables e o same dite hobe.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: shudhu apnar admin email e revalidate API cholbe (server-only, NEXT_PUBLIC noy)
# ADMIN_EMAIL=you@gmail.com

# ---- Optional: nicher gulo na dilew cholbe (ager Firebase / EmailJS account-i default hishebe ache) ----
# Notun Firebase project use korle:
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# Notun EmailJS account use korle:
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
